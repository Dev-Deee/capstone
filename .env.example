# Copy this file to .env and fill in real values. Never commit .env itself.

DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password

# Generate: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_secret_here

# GitHub App (Section 7.1 — CI/CD signal flow)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Web Push (optional — push is off unless all three are set). See README "Push notifications".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# e.g. mailto:you@example.com
VAPID_SUBJECT=
